# Server
PORT=3847
HOST=0.0.0.0
BASE_URL=http://127.0.0.1:3847

# Cryptographic signing secret (required in production).
# Generate with: openssl rand -hex 32
SIGNING_SECRET=change-me-to-a-long-random-secret

# Postgres connection string. Locally: `docker compose up -d postgres`
# On DigitalOcean: use a Managed PostgreSQL cluster's connection string.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/signed_file_api

# Local, non-public blob storage for uploaded file bytes.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# Upload limits
MAX_UPLOAD_BYTES=26214400
