# Server
PORT=3847
HOST=0.0.0.0
BASE_URL=http://127.0.0.1:3847

# Cryptographic signing secret (required in production).
# Generate with: openssl rand -hex 32
SIGNING_SECRET=change-me-to-a-long-random-secret

# Local storage (non-public)
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DATABASE_PATH=./data/files.db

# Upload limits
MAX_UPLOAD_BYTES=26214400
