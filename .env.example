# Server
PORT=3847
HOST=0.0.0.0
BASE_URL=http://127.0.0.1:3847

# Cryptographic signing secret (required in production).
# Generate with: openssl rand -hex 32
SIGNING_SECRET=change-me-to-a-long-random-secret
MAX_TTL_SECONDS=86400

# Postgres connection string. Locally: `docker compose up -d postgres`
# On DigitalOcean: use a Managed PostgreSQL cluster's connection string.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/signed_file_api

# Local, non-public blob storage for uploaded file bytes.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# Upload limits
MAX_UPLOAD_BYTES=26214400
MAX_BATCH_SIZE=20

# Structured logging: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# Exponential backoff retry policy for transient DB/storage failures.
# maxAttempts includes the initial try; retrying stops as soon as attempts
# or the elapsed-time budget is exhausted, whichever comes first.
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=100
RETRY_MAX_DELAY_MS=2000
RETRY_MAX_ELAPSED_MS=10000
